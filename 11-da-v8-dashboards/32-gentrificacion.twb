    <worksheet name='Resumen'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Resumen</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='32-dim-barrios.csv+ (Varias conexiones)' name='federated.09cepuk0wnbob41d7971v1q63g3d' />
          </datasources>
          <datasource-dependencies datasource='federated.09cepuk0wnbob41d7971v1q63g3d'>
            <column caption='Ventas mensuales' datatype='integer' name='[Calculation_1929139749859328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ventas_mensuales_usd])' />
            </column>
            <column caption='Comercios activos' datatype='integer' name='[Calculation_1929139750989826]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([id_comercio])' />
            </column>
            <column caption='Ventas YTD' datatype='integer' name='[Calculation_1929139753398275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Ventas YTD&#13;&#10;SUM(&#13;&#10;    IF [fecha_registro] &gt;= DATETRUNC(&apos;year&apos;, [Calculation_1929139753811972])&#13;&#10;       AND [fecha_registro] &lt;= [Calculation_1929139753811972]&#13;&#10;    THEN [ventas_mensuales_usd]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Fecha Máxima Datos' datatype='date' name='[Calculation_1929139753811972]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MAX([fecha_registro]) }' />
            </column>
            <column caption='Ventas PY' datatype='integer' name='[Calculation_1929139755397125]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Ventas PY&#13;&#10;SUM(&#13;&#10;    IF [fecha_registro] &gt;= DATEADD(&#13;&#10;            &apos;year&apos;,&#13;&#10;            -1,&#13;&#10;            DATETRUNC(&apos;year&apos;, [Calculation_1929139753811972])&#13;&#10;        )&#13;&#10;       AND [fecha_registro] &lt;= DATEADD(&#13;&#10;            &apos;year&apos;,&#13;&#10;            -1,&#13;&#10;            [Calculation_1929139753811972]&#13;&#10;        )&#13;&#10;    THEN [ventas_mensuales_usd]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Crecimiento Ventas YoY' datatype='real' name='[Calculation_1929139755659270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Crecimiento Ventas YoY&#13;&#10;IF [Calculation_1929139755397125] &lt;&gt; 0 THEN&#13;&#10;&#13;&#10;    ([Calculation_1929139753398275] - [Calculation_1929139755397125])&#13;&#10;    /&#13;&#10;    [Calculation_1929139755397125]&#13;&#10;&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
            </column>
            <column caption='Estatus Gentrificacion' datatype='string' name='[estatus_gentrificacion]' role='dimension' type='nominal' />
            <column caption='Fecha Registro' datatype='date' name='[fecha_registro]' role='dimension' type='ordinal' />
