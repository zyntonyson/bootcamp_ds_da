      <column caption='Año publicacion' datatype='integer' name='[Calculation_1649321512480770]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([fecha_publicacion])' />
      </column>
      <column caption='Publicaciones YoY %' datatype='real' name='[Calculation_1649321513762822]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LOOKUP(MIN(YEAR([fecha_publicacion])), -1)&#13;&#10;    = MIN(YEAR([fecha_publicacion])) - 1&#13;&#10;AND LOOKUP([Calculation_1239334356726947840], -1) != 0&#13;&#10;THEN&#13;&#10;    (&#13;&#10;        [Calculation_1239334356726947840]&#13;&#10;        - LOOKUP([Calculation_1239334356726947840], -1)&#13;&#10;    )&#13;&#10;    /&#13;&#10;    LOOKUP([Calculation_1239334356726947840], -1)&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Filtro año seleccionado' datatype='boolean' name='[Calculation_2646863343714305]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='YEAR([fecha_publicacion]) = [Parameters].[Parámetro 1649321512579075]' />
      </column>
      <column caption='Filtro Año' datatype='integer' name='[Calculation_2646863345823746]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='LOOKUP(&#13;&#10;    MIN(YEAR([fecha_publicacion])),&#13;&#10;    0&#13;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Fecha primer publicacion' datatype='date' name='[Calculation_2646863350419461]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [id_institucion] :&#13;&#10;    MIN([fecha_publicacion])&#13;&#10;}' />
      </column>
      <column caption='Meses permanencia' datatype='integer' name='[Calculation_2646863350796294]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Meses Permanencia&#13;&#10;DATEDIFF(&#13;&#10;    &apos;month&apos;,&#13;&#10;    [Calculation_2646863350419461],&#13;&#10;    [fecha_publicacion]&#13;&#10;)' />
